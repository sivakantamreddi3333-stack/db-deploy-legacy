{
  "name": "legacy-hello-job",
  "description": "Sample job deployed by GitHub Actions (legacy deployment, no DABs).",
  "tags": {
    "managed_by": "github-actions",
    "repo": "db-deploy-legacy"
  },
  "trigger": {
  "pause_status": "PAUSED",
  "periodic": {
    "interval": 1,
    "unit": "DAYS"
  },
  "tasks": [
    {
      "task_key": "hello_task",
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/legacy/db-deploy-legacy/notebooks/hello_job_notebook.py",
        "source": "WORKSPACE"
      }
    }
  ],
  "max_concurrent_runs": 1
}
